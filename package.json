{
  "name": "obsidian-property-order",
  "version": "0.4.1",
  "description": "Reorder property values and customize native property name suggestions.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check": "npm run check:runtime && npm run lint && npm run check:readme-i18n && npm run check:docs-i18n && npm run typecheck && npm test && npm run build && npm run check:release",
    "check:runtime": "node scripts/check-runtime.mjs",
    "lint": "eslint main.ts src tests benchmarks scripts esbuild.config.mjs eslint.config.mjs vitest.config.mts vitest.performance.config.mts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:docs-i18n": "node scripts/check-docs-i18n.mjs",
    "check:readme-i18n": "node scripts/check-readme-i18n.mjs",
    "check:release": "node scripts/check-release.mjs",
    "bench:usage": "vitest run --config vitest.performance.config.mts --mode quick --reporter=verbose",
    "bench:usage:large": "vitest run --config vitest.performance.config.mts --mode large --reporter=verbose",
    "acceptance:fixtures": "node scripts/create-acceptance-fixtures.mjs",
    "acceptance:conflict": "node scripts/inject-acceptance-conflict.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "properties",
    "yaml",
    "frontmatter",
    "sort"
  ],
  "author": "ZhengYX",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.23"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "0.14.0",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "4.1.9",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-plugin-obsidianmd": "0.4.1",
    "happy-dom": "20.10.6",
    "obsidian": "1.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.9"
  }
}
